# Docker image set automatically by deploy/deploy.sh
IMAGE_REPOSITORY=your-dockerhub-user/streampulse-api
IMAGE_TAG=replace-with-an-immutable-git-sha

# Public DNS records must point to the production host.
API_DOMAIN=api.example.com
GRAFANA_DOMAIN=grafana.example.com
ACME_EMAIL=ops@example.com

APP_ENV=production
SUPABASE_DB_URL=postgres://user:password@host:5432/streampulse?sslmode=require
CORS_ALLOWED_ORIGINS=https://app.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=streampulse
OTEL_DEPLOYMENT_ENVIRONMENT=production

HTTP_READ_HEADER_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
STREAM_MAX_DURATION=6h
STREAM_IDLE_TIMEOUT=30s
STREAM_WRITE_TIMEOUT=10s
STREAM_MAX_INGEST_BYTES=8589934592
STREAM_CHUNK_SIZE=32768
STREAM_CLIENT_BUFFER=64
PPROF_ENABLED=false

GRAFANA_ADMIN_USER=admin
