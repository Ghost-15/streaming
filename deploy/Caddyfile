{
	email {$ACME_EMAIL}
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Powered-By
		-Server
	}
}

{$API_DOMAIN} {
	import security_headers

	@diagnostics path /debug/* /metrics
	respond @diagnostics 404

	reverse_proxy api:8080 {
		# Disable proxy buffering so audio chunks reach listeners immediately.
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}

	log {
		output stdout
		format json
	}
}

{$GRAFANA_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy grafana:3000

	log {
		output stdout
		format json
	}
}
