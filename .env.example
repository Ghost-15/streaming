# StreamPulse — Environment variables (copy to .env and fill in values)
# 12-Factor App: never hardcode secrets in source code.
# .env is gitignored — only .env.example is committed.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development   # development | production

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=require
SUPABASE_DB_URL=postgres://postgres:password@localhost:5432/streampulse

# ── Auth JWT RS256 ────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 4096
#                openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./secrets/private.pem
JWT_PUBLIC_KEY_PATH=./secrets/public.pem

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_CLOUD_TOKEN=your_grafana_cloud_token
# Local collector: http://localhost:4317 with protocol grpc.
# Grafana Cloud direct: use the OTLP endpoint and headers copied from the
# OpenTelemetry connection tile. The token needs metrics:write and traces:write.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<grafana-provided-value>
OTEL_SERVICE_NAME=streampulse-api
# Direct OTLP metric export defaults to true when APP_ENV=production and false
# otherwise. Set it explicitly only when overriding that behavior.
# OTEL_METRICS_ENABLED=false
# Protects GET /metrics. Docker Compose reads the same value from
# ./secrets/metrics_bearer_token via METRICS_BEARER_TOKEN_FILE.
# For direct local runs, set either this value or METRICS_BEARER_TOKEN_FILE.
# METRICS_BEARER_TOKEN=change-me-local-metrics-token
# METRICS_BEARER_TOKEN_FILE=./secrets/metrics_bearer_token

# ── Security ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Long-lived HTTP audio lifecycle. Go's global ReadTimeout/WriteTimeout are not
# used for streams; these sliding deadlines apply to each audio operation.
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s
STREAM_MAX_DURATION=6h
STREAM_IDLE_TIMEOUT=30s
STREAM_WRITE_TIMEOUT=10s
STREAM_MAX_INGEST_BYTES=8589934592
STREAM_CHUNK_SIZE=32768
STREAM_CLIENT_BUFFER=64

# Diagnostics are disabled by default. docker-compose.yml enables this only on
# 127.0.0.1:6060; production explicitly disables it.
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060
